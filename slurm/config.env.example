# Cluster-specific settings. Copy to config.env and fill in for your cluster.
#
#     cp slurm/config.env.example slurm/config.env
#     ${EDITOR:-nano} slurm/config.env
#
# config.env is gitignored, so your account details and paths stay out of the
# repository. Every script in slurm/ sources it.
#
# Defaults below are set for UTSW BioHPC (Nucleus cluster). Everything marked
# TODO must still be checked against your own allocation -- `sinfo -s` lists
# partitions, `sacctmgr show assoc user=$USER` lists accounts, and
# `module avail` lists available modules.

# --- SLURM accounting -------------------------------------------------------
# TODO: GPU partition. Check what you can actually submit to with: sinfo -s
# UTSW BioHPC GPU partitions include GPUA100 and GPUH100 (recommended -- recent
# PyTorch builds target these), and older GPUv100s / GPUp100 / GPUp4. Avoid
# GPUp4 (Tesla P4, sm_61) unless you pin an older torch/CUDA combination:
# modern wheels ship no kernels for it and fail with
# "no kernel image is available for execution on the device".
SLURM_PARTITION=GPUA100

# TODO: allocation/account to charge. Leave empty if your site does not use one.
SLURM_ACCOUNT=

# GPUs per job. Increase only after confirming the training script benefits --
# a single-GPU run that queues immediately usually beats a multi-GPU run that
# waits hours for an allocation.
SLURM_GPUS=1
SLURM_CPUS=8
SLURM_MEM=64G

# Walltimes, per job role. Server sessions are interactive, so keep them within
# a working day. submit.sh passes these to sbatch.
TRAIN_TIME=24:00:00
INFER_TIME=08:00:00
SERVER_TIME=08:00:00

# Batch inference runs as a SLURM job array: INFER_ARRAY_SIZE tasks, each
# taking every Nth slide. Size it to your slide count and realistic GPU share.
# INFER_ARRAY_THROTTLE caps how many run at once (empty = no cap).
INFER_ARRAY_SIZE=4
INFER_ARRAY_THROTTLE=

# --- Environment ------------------------------------------------------------
# TODO: module that provides the container runtime. UTSW BioHPC ships a
# `singularity` module; other sites use `apptainer` or a versioned name like
# `singularity/3.9.9`. Leave empty if the binary is already on the default PATH.
APPTAINER_MODULE=singularity

# The container binary itself: `singularity` on UTSW BioHPC and other older
# sites, `apptainer` on clusters that moved to the Linux Foundation fork.
# Every slurm/ script honours this for both pulling and running images.
APPTAINER_BIN=singularity

# Outbound proxy, if your site requires one to reach Docker Hub from login
# nodes. Leave empty when direct access works. build_container.sh exports
# these (as both lower- and upper-case) before pulling.
HTTP_PROXY=
HTTPS_PROXY=

# --- Paths (all on cluster storage) -----------------------------------------
# TODO: the checkout location, on a filesystem the compute nodes can see and
# with room for a ~10 GB image plus the venv. On UTSW BioHPC use /project or
# /work space, NOT your home directory -- home quotas are small.
PROJECT_DIR=/project/$USER/path_WSI_MONAI

# TODO: where your whole-slide images live. This directory is what the
# MONAI Label server serves to QuPath.
WSI_DIR=/project/shared/slides

# --- Container image --------------------------------------------------------
# The Docker Hub image build_container.sh pulls. The MONAI project's official
# image carries CUDA, PyTorch and MONAI already matched to each other.
# Pinned tag, never :latest -- rebuilds must stay reproducible. The 1.4.0
# image is CUDA 12.x and runs on A100 (sm_80) and H100 (sm_90).
BASE_IMAGE=docker://projectmonai/monai:1.4.0

# Where the pulled .sif lands. Note the size: the image is ~10+ GB, which is
# why PROJECT_DIR above must not be in your home quota.
CONTAINER=$PROJECT_DIR/monai_base.sif

# Python virtualenv layered over the base image (created by build_container.sh
# with --system-site-packages, so the image's CUDA-matched torch is kept and
# only this project's extra dependencies are added). Lives on shared storage;
# needs no build privileges at all. Set empty only if you built a fully
# self-contained image with `build_container.sh --build-def`.
VENV_DIR=$PROJECT_DIR/venv

# Working directories
BUNDLE=$PROJECT_DIR/bundles/nuclei_segmentation
PATCH_DIR=$PROJECT_DIR/data/patches
OUTPUT_DIR=$PROJECT_DIR/outputs
LOG_DIR=$PROJECT_DIR/logs

# Extra paths to bind into the container. The runtime mounts $HOME and the CWD
# by default, but project/archive filesystems usually need to be named.
# TODO: adjust to your site's filesystems. UTSW BioHPC mounts /home2, /project,
# /work and /archive; naming a path that does not exist aborts container
# startup, so list only real ones.
BIND_PATHS=/home2,/project,/work,/archive

# --- Conda fallback ---------------------------------------------------------
# Set to 1 only if containers are impossible on your site; the sbatch scripts
# then activate the `path-wsi-monai` conda env (see environment.yml) instead.
USE_CONDA=0

# --- QuPath connection ------------------------------------------------------
# Login host used in the printed SSH-tunnel command (connection Pattern B) and
# by slurm/tunnel.sh. TODO: set to your site's login node.
LOGIN_HOST=nucleus.biohpc.swmed.edu

# --- Model / data settings --------------------------------------------------
LABELS=Nucleus
PATCH_SIZE=256
DOWNSAMPLE=1.0

# WSI reader backend: OpenSlide (default, most robust), TiffFile (plain
# pyramidal TIFFs, e.g. the synthetic test slide), or cuCIM (GPU, fragile).
WSI_BACKEND=OpenSlide

# Training hyperparameters for batch runs
MAX_EPOCHS=200
BATCH_SIZE=16
LEARNING_RATE=0.0001

# Continue training from the existing checkpoint instead of starting fresh.
FINETUNE=false

# Training data manifest (written by tools/prepare_training_data.py).
MANIFEST=$PATCH_DIR/manifest.json

# --- Batch inference settings -----------------------------------------------
# Slides to run batch inference over; defaults to WSI_DIR when empty.
INFER_INPUT_DIR=
INFER_PATCH_SIZE=512
INFER_OVERLAP=64
INFER_BATCH_SIZE=8
# Skip patches with less tissue than this fraction (0-1).
MIN_TISSUE_FRACTION=0.05

# Port the MONAI Label server listens on.
#
# 0 (the default) picks a free high port per job. Compute nodes are shared, so a
# hard-coded port will eventually collide with another user's job -- and that
# failure is confusing, because the server looks like it started and then
# nothing can reach it.
#
# Set a specific port only if your site needs a fixed one, e.g. a firewall rule
# or a standing SSH tunnel. The port in use is always printed in the job log
# either way.
MONAILABEL_PORT=0
