# Cluster-specific settings. Copy to config.env and fill in for your BioHPC.
#
#     cp slurm/config.env.example slurm/config.env
#     ${EDITOR:-nano} slurm/config.env
#
# config.env is gitignored, so your account details and paths stay out of the
# repository. Every script in slurm/ sources it.
#
# Everything marked TODO(BioHPC) must be checked against your own cluster --
# these values differ between sites and cannot be guessed. If you are unsure,
# `sinfo -s` lists partitions, `sacctmgr show assoc user=$USER` lists accounts,
# and `module avail` lists available modules.

# --- SLURM accounting -------------------------------------------------------
# TODO(BioHPC): partition/queue for GPU jobs. Check with: sinfo -s
SLURM_PARTITION=GPUp4

# TODO(BioHPC): allocation to charge. Leave empty if your site does not use one.
SLURM_ACCOUNT=

# GPUs per job. Increase only after confirming the training script benefits --
# a single-GPU run that queues immediately usually beats a multi-GPU run that
# waits hours for an allocation.
SLURM_GPUS=1
SLURM_CPUS=8
SLURM_MEM=64G

# Walltimes. Server sessions are interactive, so keep them within a working day.
TRAIN_TIME=24:00:00
INFER_TIME=08:00:00
SERVER_TIME=08:00:00

# --- Environment ------------------------------------------------------------
# TODO(BioHPC): module needed to run Apptainer/Singularity. Common variants:
#   apptainer, singularity, singularity/3.9.9
# Leave empty if it is on the default PATH.
APPTAINER_MODULE=apptainer

# The apptainer binary. Older sites still call it `singularity`.
APPTAINER_BIN=apptainer

# --- Paths (all on cluster storage) -----------------------------------------
# TODO(BioHPC): the checkout location on a filesystem the compute nodes can see.
# Home directories are sometimes not mounted on compute nodes -- check with your
# admins and use scratch or project space if so.
PROJECT_DIR=$HOME/path_WSI_MONAI

# Container image, built by slurm/build_container.sh
CONTAINER=$PROJECT_DIR/path_wsi_monai.sif

# TODO(BioHPC): where your whole-slide images live. This directory is what the
# MONAI Label server serves to QuPath.
WSI_DIR=/archive/shared/slides

# Working directories
BUNDLE=$PROJECT_DIR/bundles/nuclei_segmentation
PATCH_DIR=$PROJECT_DIR/data/patches
OUTPUT_DIR=$PROJECT_DIR/outputs
LOG_DIR=$PROJECT_DIR/logs

# Extra paths to bind into the container. Apptainer mounts $HOME and the CWD by
# default, but scratch and archive filesystems usually need to be named.
# TODO(BioHPC): adjust to your site's filesystems.
BIND_PATHS=/archive,/scratch,/work

# --- Model / data settings --------------------------------------------------
LABELS=Nucleus
PATCH_SIZE=256
DOWNSAMPLE=1.0

# WSI reader backend: OpenSlide (default, most robust), TiffFile (plain
# pyramidal TIFFs, e.g. the synthetic test slide), or cuCIM (GPU, fragile).
WSI_BACKEND=OpenSlide

# Training hyperparameters for batch runs
MAX_EPOCHS=200
BATCH_SIZE=16
LEARNING_RATE=0.0001

# Port the MONAI Label server listens on. Randomised per job by
# start_label_server.sbatch to avoid collisions with other users on a shared
# node; this is only the fallback.
MONAILABEL_PORT=8000
