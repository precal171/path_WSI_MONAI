# Container definition for a fully self-contained image: annotation server,
# training and batch inference all run out of it.
#
# This is the OPT-IN path, for sites that allow unprivileged builds:
#     bash slurm/build_container.sh --build-def
#
# The DEFAULT path needs no build privileges at all and is what most cluster
# users should run instead -- `bash slurm/build_container.sh` pulls the same
# base image and layers a virtualenv over it on shared storage. See
# docs/biohpc_setup.md.

Bootstrap: docker

# The MONAI project's official image: CUDA, PyTorch and MONAI already matched to
# each other, which is the single most annoying thing to get right by hand.
#
# Pinned deliberately -- a moving :latest makes rebuilds non-reproducible. The
# 1.4.0 image is CUDA 12.x and runs on A100 (sm_80) and H100 (sm_90) nodes,
# i.e. UTSW BioHPC's GPUA100/GPUH100 partitions. If you target older GPUs,
# check the host driver with `nvidia-smi` on a GPU node first: the container's
# CUDA runtime must be <= the driver's supported version, and the torch build
# must ship kernels for the card's compute capability (Pascal-era GPUp4 does
# not work with recent torch builds).
From: projectmonai/monai:1.4.0

%labels
    Maintainer path_WSI_MONAI
    Description MONAI Label + MONAI Core pipeline for whole-slide pathology
    Version 0.1.0

%files
    # Dependency lists are copied in so the image is self-contained. The project
    # code itself is NOT baked in -- it is bind-mounted at runtime, so you can
    # edit code and rerun without a 20-minute rebuild.
    requirements.txt /opt/requirements.txt
    requirements-train.txt /opt/requirements-train.txt

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update

    # OpenSlide's C library. openslide-python is only a wrapper; without these
    # the import succeeds and then every slide read fails, which is a confusing
    # way to discover a missing system package.
    apt-get install -y --no-install-recommends \
        openslide-tools \
        libopenslide0 \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        git \
        ca-certificates

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir --upgrade pip

    # The base image already carries a matched torch/CUDA pair. Installing our
    # requirements without constraint could silently replace it with a CPU-only
    # or mismatched build, which then fails at runtime with a confusing
    # "no kernel image is available" error. Constrain pip to the torch that is
    # already installed so the resolver cannot swap it out.
    python - <<'PYPIN' > /opt/torch-constraint.txt
import torch
print("torch==" + torch.__version__.split("+")[0])
PYPIN
    python -m pip install --no-cache-dir -c /opt/torch-constraint.txt \
        -r /opt/requirements.txt -r /opt/requirements-train.txt

    # Fail the build now rather than at 3am in a queued job. monailabel is on
    # the list deliberately: it drags in a fragile pydicom/dicomweb stack at
    # import time and is the whole point of this image -- a build that passes
    # without it just moves the failure to server startup.
    python - <<'PYCHECK'
import importlib
required = ["monai", "torch", "numpy", "openslide", "shapely", "skimage", "cv2", "PIL", "tifffile", "fire", "monailabel"]
missing = []
for module in required:
    try:
        importlib.import_module(module)
    except Exception as exc:  # noqa: BLE001
        missing.append(f"{module}: {exc}")
if missing:
    raise SystemExit("Container build check failed:\n  " + "\n  ".join(missing))
print("Container dependency check passed.")
PYCHECK

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Keep numeric libraries from oversubscribing cores; SLURM controls the
    # allocation and thread storms make jobs slower, not faster.
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
    export PYTHONUNBUFFERED=1

%runscript
    exec "$@"

%test
    python -c "import monai, torch; print('MONAI', monai.__version__, '| torch', torch.__version__)"
    python -c "import openslide; print('OpenSlide', openslide.__library_version__)"

%help
    MONAI pathology WSI pipeline.

    Run things inside this image with:
        apptainer exec --nv monai_base.sif python -m monai.bundle run ...

    --nv is what exposes the host GPU. Without it everything silently runs on
    CPU, which for whole-slide inference means hours instead of minutes.
