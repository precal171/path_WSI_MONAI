# Apptainer definition for the whole project: annotation server, training and
# batch inference all run out of this one image.
#
# Build it ON BioHPC (never locally -- see docs/biohpc_setup.md):
#     bash slurm/build_container.sh
#
# Which is roughly:
#     apptainer build path_wsi_monai.sif slurm/apptainer.def
#
# If your cluster does not allow user builds (`--fakeroot` disabled and no
# sudo), see build_container.sh, which falls back to pulling a prebuilt MONAI
# image and installing this project's dependencies into a writable overlay or a
# virtualenv on shared storage.

Bootstrap: docker

# The MONAI project's official image: CUDA, PyTorch and MONAI already matched to
# each other, which is the single most annoying thing to get right by hand.
#
# TODO(BioHPC): pin this to a specific tag rather than a moving one, and pick a
# CUDA version your cluster's driver supports. Check the driver with `nvidia-smi`
# on a GPU node: the container's CUDA runtime must be <= the host driver's
# supported version. `projectmonai/monai:1.3.0` and similar tags are on Docker Hub.
From: projectmonai/monai:latest

%labels
    Maintainer path_WSI_MONAI
    Description MONAI Label + MONAI Core pipeline for whole-slide pathology
    Version 0.1.0

%files
    # Dependency lists are copied in so the image is self-contained. The project
    # code itself is NOT baked in -- it is bind-mounted at runtime, so you can
    # edit code and rerun without a 20-minute rebuild.
    requirements.txt /opt/requirements.txt
    requirements-train.txt /opt/requirements-train.txt

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update

    # OpenSlide's C library. openslide-python is only a wrapper; without these
    # the import succeeds and then every slide read fails, which is a confusing
    # way to discover a missing system package.
    apt-get install -y --no-install-recommends \
        openslide-tools \
        libopenslide0 \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        git \
        ca-certificates

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir --upgrade pip

    # The base image already carries a matched torch/CUDA pair. Installing our
    # requirements without constraint can silently replace it with a CPU-only
    # or mismatched build, which then fails at runtime with a confusing
    # "no kernel image is available" error. Keeping the existing torch is the
    # safer default.
    python -m pip install --no-cache-dir --no-deps torch || true
    python -m pip install --no-cache-dir -r /opt/requirements.txt -r /opt/requirements-train.txt

    # Fail the build now rather than at 3am in a queued job.
    python - <<'PYCHECK'
import importlib
required = ["monai", "torch", "numpy", "openslide", "shapely", "skimage", "cv2", "PIL", "tifffile", "fire"]
missing = []
for module in required:
    try:
        importlib.import_module(module)
    except Exception as exc:  # noqa: BLE001
        missing.append(f"{module}: {exc}")
if missing:
    raise SystemExit("Container build check failed:\n  " + "\n  ".join(missing))
print("Container dependency check passed.")
PYCHECK

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Keep numeric libraries from oversubscribing cores; SLURM controls the
    # allocation and thread storms make jobs slower, not faster.
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
    export PYTHONUNBUFFERED=1

%runscript
    exec "$@"

%test
    python -c "import monai, torch; print('MONAI', monai.__version__, '| torch', torch.__version__)"
    python -c "import openslide; print('OpenSlide', openslide.__library_version__)"

%help
    MONAI pathology WSI pipeline.

    Run things inside this image with:
        apptainer exec --nv path_wsi_monai.sif python -m monai.bundle run ...

    --nv is what exposes the host GPU. Without it everything silently runs on
    CPU, which for whole-slide inference means hours instead of minutes.
